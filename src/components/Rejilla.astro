---
import type { Pelicula, Tarjeta } from "../lib/types";
import TarjetaPelicula from "./Tarjeta.astro";

interface Props {
  peliculas: (Tarjeta | Pelicula)[];
  /** Numera las tarjetas: para las páginas que son un ranking. */
  numerar?: boolean;
}

const { peliculas, numerar = false } = Astro.props;
---

<div class="grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-3 lg:grid-cols-5 xl:grid-cols-6">
  {
    peliculas.map((pelicula, indice) => (
      <TarjetaPelicula pelicula={pelicula} posicion={numerar ? indice + 1 : undefined} />
    ))
  }
</div>
