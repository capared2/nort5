---
import { compacto, nota } from "../lib/format";

interface Props {
  valor: number | null;
  votos?: number | null;
  tamano?: "normal" | "grande";
  clase?: string;
}

const { valor, votos = null, tamano = "normal", clase = "" } = Astro.props;
const grande = tamano === "grande";
---

{
  valor !== null && valor !== undefined && (
    <span class:list={["inline-flex items-baseline gap-1.5", clase]}>
      <svg
        class:list={["shrink-0 self-center fill-[var(--color-marca)]", grande ? "size-5" : "size-4"]}
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.4-5.8-3-5.8 3 1.1-6.4L2.6 9.4l6.5-.9L12 2.6z" />
      </svg>
      <strong class:list={["font-semibold tabular-nums", grande ? "text-xl" : "text-sm"]}>
        {nota(valor)}
      </strong>
      {votos ? (
        <span class:list={["text-[var(--color-tinta-tenue)]", grande ? "text-sm" : "text-xs"]}>
          {compacto(votos)}
        </span>
      ) : null}
      <span class="sr-only">sobre 10 en IMDb</span>
    </span>
  )
}
