---
import { caratula, claveGenero, colorGenero } from "../lib/format";

interface Props {
  poster: string | null | undefined;
  titulo: string;
  genero?: string;
  anio?: number | null;
  ancho?: number;
  /** La primera imagen de la página se carga sin esperar. */
  prioritaria?: boolean;
  clase?: string;
}

const {
  poster,
  titulo,
  genero = "",
  anio = null,
  ancho = 300,
  prioritaria = false,
  clase = "",
} = Astro.props;

const imagen = caratula(poster, ancho);
const acento = colorGenero(claveGenero(genero));

// Sin carátula, el hueco se compone: el acento del género, el título en grande
// y el año. Los datasets de IMDb no traen imágenes, así que esto no es un caso
// raro —es la mitad del catálogo— y tiene que verse hecho a propósito.
const grande = ancho >= 400;
---

{
  imagen ? (
    <img
      src={imagen}
      alt={`Cartel de ${titulo}`}
      loading={prioritaria ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={prioritaria ? "high" : undefined}
      class:list={["aspect-2/3 w-full object-cover", clase]}
    />
  ) : (
    <div
      class:list={[
        "relative flex aspect-2/3 w-full flex-col justify-end overflow-hidden bg-[var(--color-lienzo-alt)] p-3",
        clase,
      ]}
      style={`background-image:linear-gradient(160deg, color-mix(in srgb, ${acento} 28%, transparent) 0%, transparent 55%)`}
      aria-hidden="true"
    >
      <span
        class="absolute right-3 top-3 h-8 w-1 rounded-full opacity-70"
        style={`background:${acento}`}
      />
      <strong
        class:list={[
          "lineas-4 font-display font-bold leading-tight text-[var(--color-tinta)]",
          grande ? "text-2xl" : "text-sm",
        ]}
      >
        {titulo}
      </strong>
      {anio && (
        <span class="mt-1 text-xs tabular-nums text-[var(--color-tinta-tenue)]">{anio}</span>
      )}
    </div>
  )
}
