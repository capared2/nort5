---
import type { Indice } from "../lib/types";
import { colorGenero, enlaceGenero, nombreGenero } from "../lib/format";
import { SITIO } from "../lib/sitio";
import Logo from "./Logo.astro";

interface Props {
  indice: Indice | null;
  generoActivo?: string;
  /**
   * Página de detalle: en móvil la marca deja sitio a un botón de volver que
   * lleva aquí si no hay historial, y al título de la página.
   */
  atras?: string;
  tituloBarra?: string;
  /** En móvil, la barra de géneros solo estorba en una ficha. */
  barraGeneros?: boolean;
}

const { indice, generoActivo, atras, tituloBarra, barraGeneros = true } = Astro.props;

// Los géneros con más películas encabezan la barra; el resto queda a un toque
// en el desplegable.
const generos = [...(indice?.genres ?? [])]
  .filter((genero) => genero.tagged > 0 || genero.titles > 0)
  .sort((a, b) => b.tagged - a.tagged || b.titles - a.titles);

const destacados = generos.slice(0, 10);
---

{/* En móvil hace de barra de una app: se esconde al bajar para dejar la
     pantalla al contenido y vuelve en cuanto se sube un poco. */}
<header
  data-cabecera
  class="cabecera sticky top-0 z-30 select-none border-b border-[var(--color-linea)] bg-[var(--color-fondo)]/95 pt-[env(safe-area-inset-top)] backdrop-blur"
>
  <div class="contenedor flex items-center gap-x-3 py-2 sm:flex-wrap sm:gap-y-2 sm:py-3">
    {
      atras && (
        <a
          href={atras}
          data-atras
          aria-label="Back"
          class="pulsable -ml-2 grid size-10 shrink-0 place-items-center rounded-full sm:hidden"
        >
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 5l-7 7 7 7"></path>
          </svg>
        </a>
      )
    }

    <a
      href="/"
      class:list={["flex shrink-0 items-center gap-2.5", atras && "max-sm:hidden"]}
      aria-label={`${SITIO.nombre}, go to home`}
    >
      <Logo clase="size-8 text-[var(--color-marca)] sm:size-9" />
      <span class="flex flex-col">
        <strong class="font-display text-2xl font-extrabold leading-none tracking-tight">
          {SITIO.nombre}
        </strong>
        {/* En móvil el lema se guarda: ensanchaba tanto la marca que el botón
             de tema se descolgaba a una línea para él solo. */}
        <small class="mt-1 hidden text-[0.6rem] uppercase leading-none tracking-[0.18em] text-[var(--color-tinta-tenue)] sm:block">
          {SITIO.lema}
        </small>
      </span>
    </a>

    {/* El título de la ficha aparece en la barra cuando el grande se pierde
         por arriba, como en las apps. */}
    {
      atras && tituloBarra && (
        <p
          data-titulo-barra
          aria-hidden="true"
          class="min-w-0 flex-1 truncate font-display text-lg font-bold opacity-0 transition-opacity duration-200 sm:hidden"
        >
          {tituloBarra}
        </p>
      )
    }

    {/* En móvil buscar tiene su pestaña abajo: aquí solo quitaba pantalla. */}
    <form
      action="/search"
      method="get"
      role="search"
      class="hidden sm:ml-auto sm:block sm:max-w-md sm:flex-1"
    >
      <label for="q" class="sr-only">Search movies</label>
      <div class="relative">
        <svg
          class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 stroke-[var(--color-tinta-tenue)]"
          viewBox="0 0 24 24"
          fill="none"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5"></path>
        </svg>
        <input
          id="q"
          name="q"
          type="search"
          placeholder="Search for a movie…"
          autocomplete="off"
          class="w-full rounded-full border border-[var(--color-linea)] bg-[var(--color-lienzo)] py-2 pl-9 pr-4 text-sm outline-none placeholder:text-[var(--color-tinta-tenue)] focus:border-[var(--color-marca)]"
        />
      </div>
    </form>

    <details class="relative hidden sm:block" data-menu>
      <summary
        class="flex cursor-pointer list-none items-center gap-1.5 rounded-full border border-[var(--color-linea)] px-3.5 py-2 text-sm font-semibold hover:border-[var(--color-marca)] hover:text-[var(--color-marca)] [&::-webkit-details-marker]:hidden"
      >
        Genres
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M6 9l6 6 6-6"></path>
        </svg>
      </summary>
      <div
        class="absolute right-0 z-40 mt-2 grid max-h-[70vh] w-64 grid-cols-2 gap-1 overflow-y-auto rounded-xl border border-[var(--color-linea)] bg-[var(--color-lienzo)] p-2 shadow-2xl"
      >
        {
          generos.map((genero) => (
            <a
              href={enlaceGenero(genero.genre)}
              class="truncate rounded-lg px-2.5 py-1.5 text-sm hover:bg-[var(--color-lienzo-alt)] hover:text-[var(--color-marca)]"
            >
              {genero.name || nombreGenero(genero.genre)}
            </a>
          ))
        }
        <a
          href="/genres"
          class="col-span-2 mt-1 rounded-lg bg-[var(--color-lienzo-alt)] px-2.5 py-1.5 text-center text-sm font-semibold hover:text-[var(--color-marca)]"
        >
          All genres
        </a>
      </div>
    </details>

    <div class="ml-auto flex shrink-0 items-center gap-2 sm:ml-0">
      {
        atras && (
          <button
            type="button"
            data-compartir
            aria-label="Share"
            class="pulsable grid size-10 place-items-center rounded-full text-[var(--color-tinta-suave)] sm:hidden"
          >
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 15V3.5M7.5 8 12 3.5 16.5 8"></path>
              <path d="M8 11H6.5A1.5 1.5 0 005 12.5v7A1.5 1.5 0 006.5 21h11a1.5 1.5 0 001.5-1.5v-7a1.5 1.5 0 00-1.5-1.5H16"></path>
            </svg>
          </button>
        )
      }

      <button
        type="button"
        id="cambiar-tema"
        aria-label="Switch between light and dark theme"
        class="pulsable grid size-10 shrink-0 place-items-center rounded-full text-[var(--color-tinta-suave)] hover:border-[var(--color-marca)] hover:text-[var(--color-marca)] sm:size-9 sm:border sm:border-[var(--color-linea)]"
      >
        <svg class="size-5 sm:size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"></path>
        </svg>
      </button>
    </div>
  </div>

  {
    destacados.length > 0 && (
      <nav
        aria-label="Genres"
        data-generos
        class:list={[
          "contenedor carrusel-oculto flex snap-x snap-mandatory gap-1.5 overflow-x-auto pb-2 text-sm",
          !barraGeneros && "max-sm:hidden",
        ]}
      >
        <a
          href="/"
          aria-current={!generoActivo ? "page" : undefined}
          class:list={[
            "shrink-0 scroll-mx-5 snap-start rounded-full px-3.5 py-1.5 font-semibold max-sm:hidden",
            !generoActivo
              ? "bg-[var(--color-marca)] text-[#10131a]"
              : "text-[var(--color-tinta-suave)] hover:bg-[var(--color-lienzo-alt)]",
          ]}
        >
          Home
        </a>
        <a
          href="/top"
          aria-current={generoActivo === "top" ? "page" : undefined}
          class:list={[
            "shrink-0 scroll-mx-5 snap-start rounded-full px-3.5 py-1.5 font-semibold max-sm:hidden",
            generoActivo === "top"
              ? "bg-[var(--color-marca)] text-[#10131a]"
              : "text-[var(--color-tinta-suave)] hover:bg-[var(--color-lienzo-alt)]",
          ]}
        >
          Top rated
        </a>
        {destacados.map((genero) => (
          <a
            href={enlaceGenero(genero.genre)}
            aria-current={generoActivo === genero.genre ? "page" : undefined}
            style={generoActivo === genero.genre ? undefined : `--acento:${colorGenero(genero.genre)}`}
            class:list={[
              "pulsable shrink-0 scroll-mx-5 snap-start rounded-full px-3.5 py-1.5 font-semibold",
              generoActivo === genero.genre
                ? "bg-[var(--color-marca)] text-[#10131a]"
                : "text-[var(--color-tinta-suave)] hover:bg-[var(--color-lienzo-alt)] hover:text-[var(--acento)]",
            ]}
          >
            {genero.name || nombreGenero(genero.genre)}
          </a>
        ))}
      </nav>
    )
  }
</header>

<script>
  import { avisar } from "../lib/aviso";
  import { esClaro, ponerTema } from "../lib/tema";

  // El género en el que estás puede quedar fuera de la parte visible de la
  // barra: se centra solo al cargar, sin arrastrar la página.
  const barra = document.querySelector<HTMLElement>("[data-generos]");
  const activo = barra?.querySelector<HTMLElement>('[aria-current="page"]');
  if (barra && activo) {
    const centro = activo.offsetLeft - (barra.clientWidth - activo.clientWidth) / 2;
    barra.scrollTo({ left: Math.max(0, centro), behavior: "auto" });
  }

  // Un clic fuera cierra el desplegable de géneros.
  document.addEventListener("click", (evento) => {
    const donde = evento.target;
    if (!(donde instanceof Node)) return;
    document.querySelectorAll<HTMLDetailsElement>("details[data-menu][open]").forEach((menu) => {
      if (!menu.contains(donde)) menu.open = false;
    });
  });

  document.getElementById("cambiar-tema")?.addEventListener("click", () => ponerTema(!esClaro()));

  const cabecera = document.querySelector<HTMLElement>("[data-cabecera]");
  const movil = matchMedia("(max-width: 639px)");

  // Bajando, la barra se aparta; subiendo, vuelve. El margen evita que tiemble
  // con el pulso del dedo, y arriba del todo se queda siempre a la vista.
  if (cabecera) {
    let ultimo = scrollY;
    let pendiente = false;

    addEventListener(
      "scroll",
      () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(() => {
          pendiente = false;
          const y = Math.max(0, scrollY);
          if (Math.abs(y - ultimo) < 8) return;
          const ocultar =
            movil.matches &&
            y > ultimo &&
            y > cabecera.offsetHeight &&
            !cabecera.contains(document.activeElement);
          cabecera.toggleAttribute("data-oculta", ocultar);
          ultimo = y;
        });
      },
      { passive: true },
    );

    cabecera.addEventListener("focusin", () => cabecera.removeAttribute("data-oculta"));
  }

  // El título pequeño de la barra entra cuando el grande se va por arriba.
  const tituloBarra = document.querySelector<HTMLElement>("[data-titulo-barra]");
  const tituloGrande = document.querySelector("main h1");
  if (tituloBarra) {
    if (!tituloGrande || !("IntersectionObserver" in window)) {
      tituloBarra.classList.remove("opacity-0");
    } else {
      new IntersectionObserver(
        ([entrada]) => {
          const fuera = !entrada.isIntersecting && entrada.boundingClientRect.top < 0;
          tituloBarra.classList.toggle("opacity-0", !fuera);
        },
        { rootMargin: `-${cabecera?.offsetHeight ?? 0}px 0px 0px 0px` },
      ).observe(tituloGrande);
    }
  }

  // Volver deshace el último paso si se llegó desde el propio sitio, con su
  // scroll y todo. Si se entró de fuera (un buscador, un enlace compartido),
  // sube a la página madre en vez de sacar a la visita de la app.
  document.querySelector("[data-atras]")?.addEventListener("click", (evento) => {
    let deAqui = false;
    try {
      deAqui = new URL(document.referrer).origin === location.origin;
    } catch {
      // Sin referente: se entró directo.
    }
    if (deAqui && history.length > 1) {
      evento.preventDefault();
      history.back();
    }
  });

  // Compartir abre la hoja del sistema; donde no la hay, copia el enlace.
  document.querySelector("[data-compartir]")?.addEventListener("click", async () => {
    const url = document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href ?? location.href;
    const title = tituloBarra?.textContent?.trim() || document.title;
    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch {
        // La visita cerró la hoja sin compartir.
      }
      return;
    }
    try {
      await navigator.clipboard.writeText(url);
      avisar("Link copied");
    } catch {
      avisar("Could not copy the link");
    }
  });
</script>
