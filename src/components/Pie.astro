---
import type { Indice } from "../lib/types";
import { enlaceGenero, numero } from "../lib/format";
import { SITIO } from "../lib/sitio";
import Logo from "./Logo.astro";

interface Props {
  indice: Indice | null;
}

const { indice } = Astro.props;
const generos = [...(indice?.genres ?? [])].sort((a, b) => b.tagged - a.tagged).slice(0, 12);
---

<footer class="mt-16 border-t border-[var(--color-linea)] bg-[var(--color-lienzo)]">
  <div class="contenedor py-10">
    <div class="flex flex-wrap items-start justify-between gap-8">
      <div class="max-w-sm">
        <p class="flex items-center gap-2.5">
          <Logo clase="size-7 text-[var(--color-marca)]" />
          <strong class="font-display text-xl font-extrabold tracking-tight">{SITIO.nombre}</strong>
        </p>
        <p class="mt-3 text-sm text-[var(--color-tinta-suave)]">{SITIO.descripcion}</p>
        {
          indice && (
            <p class="mt-3 text-xs text-[var(--color-tinta-tenue)]">
              {numero(indice.total_titles)} movies across {indice.total_genres} genres.
            </p>
          )
        }
      </div>

      <nav class="min-w-52" aria-label="Genres">
        <p class="mb-2 text-xs font-bold uppercase tracking-widest text-[var(--color-tinta-tenue)]">
          Genres
        </p>
        <ul class="grid grid-cols-2 gap-x-6 gap-y-1 text-sm">
          {
            generos.map((genero) => (
              <li>
                <a href={enlaceGenero(genero.genre)} class="hover:text-[var(--color-marca)]">
                  {genero.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="min-w-32" aria-label="Sections">
        <p class="mb-2 text-xs font-bold uppercase tracking-widest text-[var(--color-tinta-tenue)]">
          This site
        </p>
        <ul class="space-y-1 text-sm">
          <li><a href="/top" class="hover:text-[var(--color-marca)]">Top rated</a></li>
          <li><a href="/genres" class="hover:text-[var(--color-marca)]">All genres</a></li>
          <li><a href="/search" class="hover:text-[var(--color-marca)]">Search</a></li>
          <li><a href="/rss.xml" class="hover:text-[var(--color-marca)]">RSS</a></li>
        </ul>
      </nav>
    </div>

    <p class="mt-8 border-t border-[var(--color-linea)] pt-5 text-xs text-[var(--color-tinta-tenue)]">
      Data and artwork come from external sources; {SITIO.nombre} is not affiliated with any of
      them. Scores and reviews belong to their respective owners.
    </p>
  </div>
</footer>
