---
import Base from "../layouts/Base.astro";
import Fila from "../components/Fila.astro";
import Estrella from "../components/Estrella.astro";
import Vacio from "../components/Vacio.astro";
import { obtenerIndice, obtenerPortada } from "../lib/data";
import { caratula, colorGenero, duracion, enlaceGenero, enlacePelicula, nombreGenero, numero } from "../lib/format";
import { SITIO } from "../lib/sitio";
import { grafoPortada } from "../lib/seo";

const [indice, portada] = await Promise.all([obtenerIndice(), obtenerPortada()]);

const populares = portada?.populares ?? [];
const [destacada, ...resto] = populares;

const generos = [...(indice?.genres ?? [])]
  .filter((genero) => genero.tagged > 0)
  .sort((a, b) => b.tagged - a.tagged);

const cartelGrande = caratula(destacada?.poster, 600);
---

<Base
  titulo={`${SITIO.titulo} · ${numero(indice?.total_titles ?? 0)} películas`}
  descripcion={
    indice
      ? `${numero(indice.total_titles)} películas reunidas y ordenadas por género: nota, sinopsis, reparto y ficha completa de cada una.`
      : SITIO.descripcion
  }
  canonical="/"
  indice={indice}
  cache={1800}
  jsonLd={grafoPortada(populares)}
>
  {
    populares.length === 0 ? (
      <Vacio
        titulo="Todavía no hay películas"
        detalle="En cuanto la recolección traiga las primeras fichas aparecerán aquí, ordenadas por género."
      />
    ) : (
      <>
        {destacada && (
          <section class="relative isolate overflow-hidden rounded-2xl border border-[var(--color-linea)] bg-[var(--color-lienzo)]">
            {/* El propio cartel hace de fondo, ampliado y desenfocado: no hay
                imagen apaisada en el archivo y esto evita pedir otra. */}
            {cartelGrande && (
              <img
                src={cartelGrande}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 -z-10 size-full scale-110 object-cover object-top blur-2xl"
              />
            )}
            <div class="absolute inset-0 -z-10 velo"></div>

            <div class="flex flex-col gap-6 p-6 sm:flex-row sm:items-center sm:gap-8 sm:p-10">
              <a
                href={enlacePelicula(destacada.id)}
                class="w-32 shrink-0 overflow-hidden rounded-xl shadow-2xl ring-1 ring-white/10 sm:w-44"
              >
                {cartelGrande ? (
                  <img
                    src={caratula(destacada.poster, 400)!}
                    alt={`Cartel de ${destacada.title}`}
                    class="aspect-2/3 w-full object-cover"
                    fetchpriority="high"
                  />
                ) : (
                  <div class="aspect-2/3 w-full bg-[var(--color-lienzo-alt)]" />
                )}
              </a>

              <div class="min-w-0">
                <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--color-marca)]">
                  Lo más visto ahora
                </p>
                <h1 class="mt-2 font-display text-3xl font-extrabold leading-[1.05] tracking-tight sm:text-5xl">
                  <a href={enlacePelicula(destacada.id)} class="hover:text-[var(--color-marca)]">
                    {destacada.title}
                  </a>
                </h1>
                <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-[var(--color-tinta-suave)]">
                  <Estrella valor={destacada.rating} votos={destacada.votes} tamano="grande" />
                  {destacada.year && <span>{destacada.year}</span>}
                  {destacada.runtime_minutes ? <span>{duracion(destacada.runtime_minutes)}</span> : null}
                  {destacada.certificate && (
                    <span class="rounded border border-[var(--color-linea)] px-1.5 py-0.5 text-xs">
                      {destacada.certificate}
                    </span>
                  )}
                </p>
                {destacada.plot && (
                  <p class="lineas-3 mt-3 max-w-xl text-[var(--color-tinta-suave)]">{destacada.plot}</p>
                )}
                <p class="mt-5">
                  <a
                    href={enlacePelicula(destacada.id)}
                    class="inline-flex items-center gap-2 rounded-full bg-[var(--color-marca)] px-5 py-2.5 text-sm font-bold text-[#10131a] hover:bg-[var(--color-marca-oscuro)]"
                  >
                    Ver la ficha
                    <span aria-hidden="true">›</span>
                  </a>
                </p>
              </div>
            </div>
          </section>
        )}

        <Fila titulo="Lo más visto" peliculas={resto} enlace="/top" />
        <Fila
          titulo="Mejor valoradas"
          peliculas={portada?.mejor_valoradas ?? []}
          enlace="/top"
          numerar
        />
        <Fila titulo="Estrenos recientes" peliculas={portada?.recientes ?? []} />
        <Fila titulo="Clásicos que aguantan" peliculas={portada?.clasicos ?? []} />

        {generos.length > 0 && (
          <section class="mt-12">
            <h2 class="mb-3 font-display text-xl font-bold tracking-tight sm:text-2xl">
              <span class="mr-2 inline-block h-5 w-1 translate-y-0.5 rounded-full bg-[var(--color-marca)]" />
              Por género
            </h2>
            <div class="flex flex-wrap gap-2">
              {generos.map((genero) => (
                <a
                  href={enlaceGenero(genero.genre)}
                  style={`--acento:${colorGenero(genero.genre)}`}
                  class="rounded-full border border-[var(--color-linea)] px-4 py-2 text-sm font-semibold hover:border-[var(--acento)] hover:text-[var(--acento)]"
                >
                  {genero.name || nombreGenero(genero.genre)}
                  <span class="ml-1.5 text-xs text-[var(--color-tinta-tenue)]">{numero(genero.tagged)}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </>
    )
  }
</Base>
