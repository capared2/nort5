---
import Base from "../layouts/Base.astro";
import TarjetaPelicula from "../components/Tarjeta.astro";
import Vacio from "../components/Vacio.astro";
import Banner from "../components/Banner.astro";
import BannerNativo from "../components/BannerNativo.astro";
import { obtenerIndice, obtenerPortada } from "../lib/data";
import { numero } from "../lib/format";
import { SITIO } from "../lib/sitio";
import { grafoTop } from "../lib/seo";

const [indice, portada] = await Promise.all([obtenerIndice(), obtenerPortada()]);
const peliculas = portada?.mejor_valoradas ?? [];
---

<Base
  titulo={`Best rated movies | ${SITIO.nombre}`}
  descripcion="The best rated movies in the catalogue, counting only those with enough votes to back the score."
  canonical="/top"
  indice={indice}
  generoActivo="top"
  cache={3600}
  jsonLd={grafoTop(peliculas)}
>
  <header class="mb-8 border-b border-[var(--color-linea)] pb-5">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--color-marca)]">Ranking</p>
    <h1 class="mt-1 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">
      Top rated
    </h1>
    <p class="mt-2 max-w-2xl text-sm text-[var(--color-tinta-tenue)]">
      Sorted by score. Only movies past 25,000 votes make the cut: one with forty votes and a
      9.4 is not competing with these.
      {indice && ` Out of a catalogue of ${numero(indice.total_titles)} movies.`}
    </p>
  </header>

  <Banner hueco="horizontal" clase="mb-8" />

  {
    peliculas.length === 0 ? (
      <Vacio
        titulo="The ranking is empty"
        detalle="It needs movies with enough votes to come in first."
      />
    ) : (
      <ol>
        {peliculas.map((pelicula, indiceLista) => (
          <>
            <li>
              <TarjetaPelicula pelicula={pelicula} variante="lista" posicion={indiceLista + 1} />
            </li>
            {(indiceLista + 1) % 5 === 0 && indiceLista + 1 < peliculas.length && (
              <li>
                <Banner hueco="horizontal" clase="my-6" />
              </li>
            )}
          </>
        ))}
      </ol>
    )
  }

  <BannerNativo clase="mt-10" />
  <Banner hueco="franja" clase="mt-8" />
</Base>
