---
import Base from "../layouts/Base.astro";
import TarjetaPelicula from "../components/Tarjeta.astro";
import Vacio from "../components/Vacio.astro";
import { obtenerIndice, obtenerPortada } from "../lib/data";
import { numero } from "../lib/format";
import { SITIO } from "../lib/sitio";
import { grafoTop } from "../lib/seo";

const [indice, portada] = await Promise.all([obtenerIndice(), obtenerPortada()]);
const peliculas = portada?.mejor_valoradas ?? [];
---

<Base
  titulo={`Las mejores películas de la historia | ${SITIO.nombre}`}
  descripcion="El ranking de las películas mejor valoradas del catálogo, contando solo las que tienen votos suficientes para sostener la nota."
  canonical="/top"
  indice={indice}
  generoActivo="top"
  cache={3600}
  jsonLd={grafoTop(peliculas)}
>
  <header class="mb-8 border-b border-[var(--color-linea)] pb-5">
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--color-marca)]">Ranking</p>
    <h1 class="mt-1 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">
      Mejor valoradas
    </h1>
    <p class="mt-2 max-w-2xl text-sm text-[var(--color-tinta-tenue)]">
      Ordenadas por nota. Solo entran las que pasan de 25.000 votos: una película con cuarenta
      votos y un 9,4 no compite con las de aquí.
      {indice && ` Sobre un catálogo de ${numero(indice.total_titles)} películas.`}
    </p>
  </header>

  {
    peliculas.length === 0 ? (
      <Vacio
        titulo="El ranking está vacío"
        detalle="Hace falta que la recolección traiga películas con votos suficientes."
      />
    ) : (
      <ol>
        {peliculas.map((pelicula, indiceLista) => (
          <li>
            <TarjetaPelicula pelicula={pelicula} variante="lista" posicion={indiceLista + 1} />
          </li>
        ))}
      </ol>
    )
  }
</Base>
