---
import Base from "../layouts/Base.astro";
import { obtenerIndice } from "../lib/data";
import { SITIO } from "../lib/sitio";

const indice = await obtenerIndice();
---

<Base
  titulo={`Esta página no existe | ${SITIO.nombre}`}
  descripcion="La página que buscabas no está aquí."
  canonical="/404"
  indice={indice}
  cache={86400}
  noindex
>
  <div class="py-16 text-center">
    <p class="font-display text-7xl font-extrabold text-[var(--color-marca)]">404</p>
    <h1 class="mt-3 font-display text-3xl font-extrabold tracking-tight">Corte y se acabó</h1>
    <p class="mx-auto mt-3 max-w-md text-[var(--color-tinta-suave)]">
      Esta página no existe, o la película que buscabas todavía no ha entrado en el catálogo.
    </p>
    <p class="mt-7 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="rounded-full bg-[var(--color-marca)] px-5 py-2.5 text-sm font-bold text-[#10131a] hover:bg-[var(--color-marca-oscuro)]"
      >
        Volver al inicio
      </a>
      <a
        href="/generos"
        class="rounded-full border border-[var(--color-linea)] px-5 py-2.5 text-sm font-semibold hover:border-[var(--color-marca)] hover:text-[var(--color-marca)]"
      >
        Ver los géneros
      </a>
    </p>
  </div>
</Base>
