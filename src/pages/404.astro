---
import Base from "../layouts/Base.astro";
import { obtenerIndice } from "../lib/data";
import { SITIO } from "../lib/sitio";

const indice = await obtenerIndice();

// Se sirve tambien cuando una ficha o un genero no existen, y en ese caso hay
// que devolver 404 y no 200: si no, los buscadores indexan paginas de error.
Astro.response.status = 404;
---

<Base
  titulo={`This page does not exist | ${SITIO.nombre}`}
  descripcion="The page you were after is not here."
  canonical="/404"
  indice={indice}
  cache={86400}
  noindex
>
  <div class="py-16 text-center">
    <p class="font-display text-7xl font-extrabold text-[var(--color-marca)]">404</p>
    <h1 class="mt-3 font-display text-3xl font-extrabold tracking-tight">Cut. That is a wrap.</h1>
    <p class="mx-auto mt-3 max-w-md text-[var(--color-tinta-suave)]">
      This page does not exist, or the movie you were after has not made it into the catalogue yet.
    </p>
    <p class="mt-7 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="rounded-full bg-[var(--color-marca)] px-5 py-2.5 text-sm font-bold text-[#10131a] hover:bg-[var(--color-marca-oscuro)]"
      >
        Back to home
      </a>
      <a
        href="/genres"
        class="rounded-full border border-[var(--color-linea)] px-5 py-2.5 text-sm font-semibold hover:border-[var(--color-marca)] hover:text-[var(--color-marca)]"
      >
        Browse genres
      </a>
    </p>
  </div>
</Base>
