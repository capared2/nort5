---
import "../styles/global.css";
import Cabecera from "../components/Cabecera.astro";
import Pie from "../components/Pie.astro";
import Seo from "../components/Seo.astro";
import Anuncios from "../components/Anuncios.astro";
import Banner from "../components/Banner.astro";
import Analitica from "../components/Analitica.astro";
import BarraInferior, { type Seccion } from "../components/BarraInferior.astro";
import Menu from "../components/Menu.astro";
import type { Indice } from "../lib/types";
import { SITIO } from "../lib/sitio";

interface Props {
  titulo: string;
  descripcion?: string;
  /** Ruta canónica de esta página. */
  canonical: string;
  indice: Indice | null;
  /** Segundos que el edge de Cloudflare puede reutilizar la respuesta. */
  cache?: number;
  generoActivo?: string;
  imagen?: string | null;
  tipo?: "website" | "video.movie";
  estreno?: string | null;
  duracionMinutos?: number | null;
  etiquetas?: string[];
  noindex?: boolean;
  jsonLd?: object[];
  anterior?: string | null;
  siguiente?: string | null;
  /** El contenido llega hasta el borde: para las fichas con cartel a sangre. */
  ancho?: boolean;
  /**
   * Página de detalle. En móvil la cabecera pone un botón de volver, que sin
   * historial lleva a esta ruta, y el título corto de la página.
   */
  atras?: string;
  tituloBarra?: string;
  /** En móvil, enseñar la barra de géneros bajo la cabecera. */
  barraGeneros?: boolean;
}

const {
  titulo,
  descripcion = SITIO.descripcion,
  canonical,
  indice,
  cache = 3600,
  generoActivo,
  ancho = false,
  atras,
  tituloBarra,
  barraGeneros = true,
  ...seo
} = Astro.props;

// La pestaña de abajo que se enciende. Las fichas no tienen pestaña propia.
const ruta = Astro.url.pathname.replace(/\/+$/, "") || "/";
const seccion: Seccion | undefined =
  ruta === "/"
    ? "inicio"
    : ruta === "/top"
      ? "top"
      : ruta === "/genres" || ruta.startsWith("/genre/")
        ? "generos"
        : ruta === "/search"
          ? "buscar"
          : undefined;

// El catálogo se rehace cada pocas horas: servir desde el edge y revalidar en
// segundo plano mantiene el sitio rápido sin quedarse obsoleto.
Astro.response.headers.set(
  "Cache-Control",
  `public, max-age=300, s-maxage=${cache}, stale-while-revalidate=86400`,
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/* `viewport-fit=cover` lleva la página bajo la muesca y la barra de
         inicio del iPhone; las barras fijas se apartan con los safe-area. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Seo titulo={titulo} descripcion={descripcion} canonical={canonical} {...seo} />

    <Analitica />

    <link rel="dns-prefetch" href="https://www.highrevenueformat.com" />
    <link rel="dns-prefetch" href="https://pl31044366.profitableratecpmnetwork.com" />
    <link rel="dns-prefetch" href="https://pl31044373.profitableratecpmnetwork.com" />
    <link rel="dns-prefetch" href="https://pl31608868.profitableratecpmnetwork.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* De aquí vienen las carátulas: adelantar la conexión ahorra el saludo
         TCP en una parrilla que enseña treinta imágenes de golpe. */}
    <link rel="preconnect" href="https://resizing.flixster.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* iOS no acepta SVG en la pantalla de inicio. */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0b0d12" />

    {/* Instalable como app: a pantalla completa, con su icono y sin la barra
        del navegador. La barra de estado de iOS va en negro y no translúcida:
        con el tema claro, un reloj blanco sobre fondo blanco no se vería. */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="application-name" content={SITIO.nombre} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={SITIO.nombre} />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="format-detection" content="telephone=no" />

    {/* Inline a propósito: el tema tiene que aplicarse antes de pintar, o hay
        destello, y el sentido de la transición entre páginas se decide en
        `pagereveal`, que llega antes del primer pintado: volver atrás desliza
        hacia la derecha y abrir una ficha, hacia la izquierda (ver
        global.css). Sin comentarios dentro, que este guion sí viaja al
        navegador. */}
    <script is:inline>
      addEventListener(
        "error",
        (evento) => {
          if (evento.target instanceof HTMLImageElement) evento.target.style.visibility = "hidden";
        },
        true,
      );

      try {
        if (localStorage.getItem("tema") === "claro") {
          document.documentElement.classList.add("claro");
          document.querySelector('meta[name="theme-color"]').setAttribute("content", "#f5f6f8");
        }
      } catch (fallo) {}

      addEventListener("pagereveal", (evento) => {
        var activacion = window.navigation && navigation.activation;
        if (!evento.viewTransition || !activacion || !activacion.entry) return;
        var desde = activacion.from;
        if (activacion.navigationType === "traverse" && desde && desde.index > activacion.entry.index) {
          evento.viewTransition.types.add("atras");
        } else if (activacion.navigationType === "push" && !/^\/(top|genres|search)?\/?$/.test(location.pathname)) {
          evento.viewTransition.types.add("adelante");
        }
      });

      if ("serviceWorker" in navigator) {
        addEventListener("load", function () {
          navigator.serviceWorker.register("/sw.js").catch(function () {});
        });
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded focus:bg-[var(--color-marca)] focus:px-4 focus:py-2 focus:text-[#10131a]"
    >
      Skip to content
    </a>

    <Cabecera
      indice={indice}
      generoActivo={generoActivo}
      atras={atras}
      tituloBarra={tituloBarra}
      barraGeneros={barraGeneros}
    />

    <main id="contenido" class:list={["w-full flex-1", ancho ? "" : "contenedor py-6 sm:py-8"]}>
      <slot />
    </main>

    <Pie indice={indice} />

    <BarraInferior seccion={seccion} />
    <Menu indice={indice} />

    {/* El indicador de «tirar para recargar». Solo se usa instalada como app,
        donde no hay botón de recargar del navegador (ver global.css). */}
    <div class="recarga" data-recarga aria-hidden="true">
      <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
        <path d="M20 12a8 8 0 11-2.3-5.7M20 4v4.5h-4.5"></path>
      </svg>
    </div>

    {/* Los rascacielos van fuera del flujo, en el margen que sobra a los
        lados del contenedor: así no empujan el contenido ni cambian el
        ancho de lectura. Solo aparecen desde 1664px (ver global.css). */}
    <div class="rail rail-izquierda">
      <Banner hueco="vertical" etiqueta={false} />
    </div>
    <div class="rail rail-derecha">
      <Banner hueco="columna" etiqueta={false} />
    </div>

    <Anuncios />
  </body>
</html>

<script>
  // Tirar hacia abajo desde arriba del todo recarga la página. Solo instalada
  // como app: en el navegador ya lo hace él, y duplicarlo sería un estorbo.
  const indicador = document.querySelector<HTMLElement>("[data-recarga]");
  const instalada =
    matchMedia("(display-mode: standalone)").matches ||
    (navigator as Navigator & { standalone?: boolean }).standalone === true;

  if (indicador && instalada) {
    const UMBRAL = 70;
    let inicio: number | null = null;
    let tiron = 0;

    const reponer = () => {
      indicador.style.removeProperty("transform");
      indicador.style.removeProperty("opacity");
    };

    addEventListener(
      "touchstart",
      (evento) => {
        const libre = scrollY <= 0 && evento.touches.length === 1 && !document.querySelector(":popover-open");
        inicio = libre ? evento.touches[0].clientY : null;
        tiron = 0;
      },
      { passive: true },
    );

    addEventListener(
      "touchmove",
      (evento) => {
        if (inicio === null) return;
        if (scrollY > 0) {
          inicio = null;
          reponer();
          return;
        }
        // La resistencia de un muelle: cuanto más se tira, menos avanza.
        tiron = Math.max(0, evento.touches[0].clientY - inicio) * 0.5;
        const recorrido = Math.min(tiron, UMBRAL * 1.4);
        indicador.style.transform = `translateY(${recorrido}px) rotate(${recorrido * 4}deg)`;
        indicador.style.opacity = String(Math.min(1, tiron / UMBRAL));
      },
      { passive: true },
    );

    addEventListener("touchend", () => {
      if (inicio === null) return;
      inicio = null;
      if (tiron >= UMBRAL) {
        indicador.classList.add("girando");
        location.reload();
      } else {
        reponer();
      }
    });
  }
</script>
